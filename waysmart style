/*==========================================================
            DASHBOARD
==========================================================*/

.dashboard{

display:grid;

grid-template-columns:2fr 420px;

gap:30px;

margin-bottom:40px;

}

/*==========================================================
            PANEL DEL MAPA
==========================================================*/

.map-panel{

background:white;

border-radius:20px;

padding:25px;

box-shadow:var(--shadow);

position:relative;

overflow:hidden;

}

.panel-header{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:20px;

}

.panel-header h2{

font-size:24px;

font-weight:700;

color:var(--text);

display:flex;

align-items:center;

gap:12px;

}

.panel-header i{

color:var(--primary);

}

.map-buttons{

display:flex;

gap:12px;

}

.map-buttons button{

width:45px;

height:45px;

border:none;

border-radius:50%;

background:var(--primary);

color:white;

font-size:18px;

cursor:pointer;

transition:.3s;

}

.map-buttons button:hover{

background:var(--primary-dark);

transform:scale(1.08);

}

.map-container{

position:relative;

height:650px;

border-radius:20px;

overflow:hidden;

background:#ddd;

}

.map-container iframe{

width:100%;

height:100%;

border:none;

}

/*==========================================================
            RUTAS
==========================================================*/

.route{

position:absolute;

padding:12px 18px;

border-radius:30px;

color:white;

font-size:14px;

font-weight:600;

box-shadow:0 8px 20px rgba(0,0,0,.2);

animation:flotar 3s ease-in-out infinite;

}

.blue-route{

background:#0d6efd;

left:90px;

top:120px;

}

.green-route{

background:#10b981;

right:70px;

top:260px;

}

.orange-route{

background:#f97316;

left:220px;

bottom:90px;

}

@keyframes flotar{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-8px);

}

100%{

transform:translateY(0);

}

}

/*==========================================================
            PANEL DERECHO
==========================================================*/

.right-panel{

display:flex;

flex-direction:column;

gap:25px;

}

/*==========================================================
            WIDGETS
==========================================================*/

.widget{

background:white;

border-radius:20px;

padding:25px;

box-shadow:var(--shadow);

transition:.35s;

}

.widget:hover{

transform:translateY(-6px);

}

.widget h3{

display:flex;

align-items:center;

gap:10px;

margin-bottom:20px;

font-size:22px;

color:var(--text);

}

.widget h3 i{

color:var(--primary);

}

/*==========================================================
            GEOLOCALIZACIÓN
==========================================================*/

.location-btn{

width:100%;

padding:14px;

border:none;

background:linear-gradient(90deg,#0d6efd,#1e88ff);

color:white;

font-size:16px;

font-weight:600;

border-radius:12px;

cursor:pointer;

transition:.3s;

margin-bottom:15px;

}

.location-btn:hover{

transform:translateY(-2px);

box-shadow:0 10px 20px rgba(13,110,253,.25);

}

#geo-status{

font-size:14px;

line-height:1.7;

color:var(--text-light);

}

/*==========================================================
            PEDIDOS
==========================================================*/

.order{

padding:18px;

background:#f8fbff;

border-radius:15px;

margin-bottom:15px;

border-left:5px solid var(--primary);

transition:.3s;

}

.order:hover{

transform:translateX(8px);

}

.order h4{

margin-bottom:8px;

font-size:17px;

}

.order p{

color:var(--text-light);

margin-bottom:5px;

}

.order span{

font-size:13px;

color:var(--success);

font-weight:600;

}

/*==========================================================
            NOTIFICACIONES
==========================================================*/

.notice{

padding:16px;

border-radius:12px;

margin-bottom:15px;

font-weight:500;

}

.notice.success{

background:#dcfce7;

color:#166534;

}

.notice.warning{

background:#fef3c7;

color:#92400e;

}

.notice.info{

background:#dbeafe;

color:#1d4ed8;

}

/*==========================================================
            CONDUCTORES
==========================================================*/

.driver{

display:flex;

align-items:center;

gap:15px;

padding:15px 0;

border-bottom:1px solid #e5e7eb;

}

.driver:last-child{

border:none;

}

.driver img{

width:55px;

height:55px;

border-radius:50%;

object-fit:cover;

border:3px solid var(--primary);

}

.driver h4{

font-size:16px;

margin-bottom:3px;

}

.driver p{

font-size:13px;

color:var(--text-light);

}

.online{

margin-left:auto;

width:14px;

height:14px;

border-radius:50%;

background:#22c55e;

box-shadow:0 0 10px #22c55e;

animation:pulse 1.5s infinite;

}

@keyframes pulse{

0%{

transform:scale(1);

opacity:1;

}

50%{

transform:scale(1.4);

opacity:.5;

}

100%{

transform:scale(1);

opacity:1;

}

}